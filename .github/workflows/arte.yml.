name: Arte de comandantes

on:
  push:
    paths: [".github/workflows/arte.yml"]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  arte:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - run: pip install pillow
      - name: Descargar el arte de Scryfall
        shell: python
        run: |
          import json, time, io, os, urllib.request, urllib.parse, concurrent.futures as cf
          from PIL import Image
          H = {"User-Agent": "SynerveilArt/1.0", "Accept": "application/json"}
          def get(url, accept="application/json"):
              for i in range(5):
                  try:
                      rq = urllib.request.Request(url, headers={**H, "Accept": accept})
                      with urllib.request.urlopen(rq, timeout=60) as r:
                          return r.read()
                  except Exception as e:
                      print("retry", url, e); time.sleep(2 + i * 3)
              return None
          q = "legal:commander (is:commander or t:background)"
          url = "https://api.scryfall.com/cards/search?" + urllib.parse.urlencode({"q": q, "unique": "cards", "order": "edhrec"})
          cards = []
          while url:
              page = json.loads(get(url)); cards += page["data"]
              url = page.get("next_page"); time.sleep(0.12)
          print("cartas:", len(cards))
          os.makedirs("arte", exist_ok=True)
          def art(c):
              u = (c.get("image_uris") or (c.get("card_faces") or [{}])[0].get("image_uris") or {}).get("art_crop")
              return u
          index = {}
          def work(i_c):
              i, c = i_c
              u = art(c)
              if not u: return None
              b = get(u, "image/*")
              if not b: return None
              im = Image.open(io.BytesIO(b)).convert("RGB")
              k = 512 / max(im.size)
              if k < 1: im = im.resize((round(im.width * k), round(im.height * k)), Image.LANCZOS)
              f = f"{i}.jpg"; im.save("arte/" + f, quality=82)
              return c["name"], f
          with cf.ThreadPoolExecutor(8) as ex:
              for res in ex.map(work, enumerate(cards)):
                  if res: index[res[0]] = res[1]
          json.dump(index, open("arte/index.json", "w"), ensure_ascii=False)
          print("imagenes:", len(index))
      - name: Publicar
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          tar -cf arte.tar arte
          gh release delete arte --yes --cleanup-tag --repo "$GITHUB_REPOSITORY" || true
          gh release create arte arte.tar --title "Arte de comandantes" --notes "Imágenes de Scryfall para Synerveil" --repo "$GITHUB_REPOSITORY"
